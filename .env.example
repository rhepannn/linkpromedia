# ─────────────────────────────────────────
# LinkProMedia — Environment Variables
# Salin file ini ke .env dan isi nilainya
# ─────────────────────────────────────────

# ─────────────────────────────────────────
# Database (Supabase PostgreSQL) — WAJIB lewat pooler
# ─────────────────────────────────────────
# Host DIRECT Supabase (db.PROJECT.supabase.co) hanya punya AAAA record
# (IPv6-only) dan gagal di jaringan tanpa IPv6 — jangan dipakai.
#
# DATABASE_URL = TRANSACTION pooler, port 6543. Dipakai saat aplikasi jalan.
#   Session pooler (5432) menahan satu koneksi per klien sepanjang sesi dan
#   dibatasi pool_size 16, jadi cepat memunculkan
#   "max clients reached in session mode" begitu trafik naik.
#   pgbouncer=true wajib (Prisma mematikan prepared statement),
#   connection_limit=10 terbukti cukup untuk homepage tanpa memicu timeout pool.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?schema=public&pgbouncer=true&connection_limit=10"

# DIRECT_URL = SESSION pooler, port 5432. Hanya dipakai perintah schema
#   (prisma db push / migrate) yang tidak bisa lewat pooler transaction.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=public"

# URL Aplikasi (dipakai untuk sitemap, OG tags, share links)
NEXT_PUBLIC_APP_URL="https://linkpromedia.id"

# NextAuth.js v5
# Generate secret: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-random-string-yang-panjang"
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────
# Supabase Storage — upload gambar Media Library
# ─────────────────────────────────────────

SUPABASE_URL="https://PROJECT.supabase.co"
# Service role key HANYA di server — jangan pernah dibagikan/di-commit
SUPABASE_SERVICE_ROLE_KEY=""

# ─────────────────────────────────────────
# AI teks — rantai penyedia berurutan (lihat src/lib/aiProvider.ts).
# Groq wajib; sisanya opsional: kalau kuota Groq habis, sistem otomatis
# pindah ke penyedia berikutnya yang kuncinya terisi.
# ─────────────────────────────────────────

GROQ_API_KEY=""
# Cadangan 1 — Cerebras (gpt-oss-120b). CATATAN Agu 2026: akun baru Cerebras
# tidak lagi dapat kuota gratis ("payment required") — biarkan kosong kecuali
# akunnya berbayar; kunci yang selalu ditolak hanya menambah tunda saat
# Groq sedang gagal.
CEREBRAS_API_KEY=""
# Cadangan 2 — Google Gemini (gemini-flash-latest). TERUJI AKTIF gratis.
# Daftar: aistudio.google.com -> Get API key
GEMINI_API_KEY=""
# Disimpan untuk nanti, belum dipakai
# ANTHROPIC_API_KEY=""

# Riset web di ChatBot (fitur "riset topik ..."). Daftar gratis di tavily.com
# (1.000 kredit/bulan; satu riset memakai 2 kredit). Kosong = fitur riset
# menolak dengan pesan cara memasangnya, fitur lain tidak terpengaruh.
TAVILY_API_KEY=""

# ─────────────────────────────────────────
# Push Notification (VAPID)
# Buat sepasang kunci: npx web-push generate-vapid-keys
# ─────────────────────────────────────────

# Kunci publik dikirim ke browser — aman terlihat
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# Kunci privat HANYA di server — jangan pernah dibagikan
VAPID_PRIVATE_KEY=""
# Kontak yang bisa dihubungi layanan push bila ada masalah
VAPID_SUBJECT="mailto:redaksi@linkpromedia.id"

# ─────────────────────────────────────────
# Cron (Vercel)
# ─────────────────────────────────────────

# Kalau diset, endpoint /api/cron/* menolak permintaan tanpa header
# "Authorization: Bearer <CRON_SECRET>". Vercel mengirimkannya otomatis.
# Generate: openssl rand -hex 32
CRON_SECRET=""
